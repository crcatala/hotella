{
  "name": "hotella",
  "version": "0.1.3",
  "description": "Search hotel prices and availability from the terminal via Google Hotels",
  "license": "MIT",
  "author": "crcatala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcatala/hotella.git"
  },
  "homepage": "https://github.com/crcatala/hotella",
  "bugs": {
    "url": "https://github.com/crcatala/hotella/issues"
  },
  "keywords": [
    "hotel",
    "travel",
    "cli",
    "google-hotels",
    "price-comparison",
    "scraper",
    "terminal"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hotella": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsgo",
    "dev": "tsx src/cli.ts",
    "test": "bash scripts/check.sh test",
    "test:verbose": "bash scripts/test-unit.sh",
    "test:live": "HOTELLA_LIVE_REQUEST_DELAY_MS=1000 bash scripts/check.sh test:live",
    "test:live:verbose": "HOTELLA_LIVE_TEST=1 HOTELLA_LIVE_REQUEST_DELAY_MS=1000 pnpm exec vitest run tests/live",
    "test:all": "HOTELLA_LIVE_REQUEST_DELAY_MS=1000 bash scripts/check.sh test:all",
    "test:all:verbose": "HOTELLA_LIVE_TEST=1 HOTELLA_LIVE_REQUEST_DELAY_MS=1000 pnpm exec vitest run",
    "test:watch": "vitest",
    "lint": "bash scripts/check.sh lint",
    "lint:fix": "oxlint --fix src/",
    "lint:verbose": "oxlint src/",
    "format": "bash scripts/check.sh format-fix",
    "format:verbose": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" README.md",
    "format:check": "bash scripts/check.sh format",
    "format:check:verbose": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" README.md",
    "typecheck": "bash scripts/check.sh typecheck",
    "typecheck:verbose": "tsgo --noEmit",
    "verify": "pnpm exec tsx scripts/verify.ts",
    "verify:verbose": "VERBOSE=1 pnpm exec tsx scripts/verify.ts",
    "test:package": "pnpm run build && bash scripts/test-package.sh",
    "prepare": "lefthook install || true",
    "prepublishOnly": "pnpm run verify",
    "release": "release-it",
    "release:dry": "release-it --dry-run --no-npm --no-github",
    "release:prep": "bash scripts/prep-release.sh",
    "iata:refresh": "node scripts/refresh-iata-data.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.0",
    "impit": "^0.14.0",
    "kleur": "^4.1.5",
    "ora": "^9.1.0"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^7.0.0",
    "@types/node": "^22.20.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "^2.0.16",
    "oxlint": "^1.42.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "tasuku": "^2.0.5",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0"
}
